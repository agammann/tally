generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  projects Project[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
model Installation {
  id Int @id @default(1)
  ownerId String @unique
  createdAt DateTime @default(now())
}
model Project {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  name String
  ingestionId String @unique @default(uuid())
  origins String[]
  tools String[]
  environments String[]
  releases String[]
  errorCodes String[]
  routeLabels String[]
  workflowName String
  workflowVersion Int @default(1)
  workflowWindowMs Int @default(1800000)
  retentionDays Int @default(30)
  dailyQuota Int @default(100000)
  createdAt DateTime @default(now())
  events Event[]
  counters Counter[]
  @@index([ownerId])
}
model Event {
  id BigInt @id @default(autoincrement())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  eventId String
  schemaVersion Int
  kind String
  invocationId String?
  tool String?
  toolVersion String?
  release String?
  environment String
  source String
  clientAt DateTime
  receivedAt DateTime @default(now())
  durationMs Float?
  outcome String?
  errorCode String?
  workflowId String?
  workflowName String?
  workflowVersion Int?
  workflowWindowMs Int?
  routeLabel String?
  @@unique([projectId,eventId])
  @@index([projectId,environment,clientAt])
  @@index([projectId,tool,release,clientAt])
  @@index([projectId,invocationId])
  @@index([projectId,workflowId])
  @@index([projectId,receivedAt])
  @@index([projectId,kind,clientAt])
}
model Counter {
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  key String
  count Int
  expiresAt DateTime
  @@id([projectId,key])
}
